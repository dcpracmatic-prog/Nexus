# NEXUS local environment
# Interpreter: LLaMA via Ollama (optional). If unavailable, deterministic local fallback is used.
OLLAMA_URL="http://127.0.0.1:11434/api/chat"
LLAMA_MODEL="llama3.2:3b"

# APP_URL: public URL when deployed (optional for local).
APP_URL="http://localhost:3000"

# Legacy tools / sandbox policy
# NEXUS_LEGACY_TOOLS_ENABLED="false"
# NEXUS_SANDBOX_TTL_MS="600000"
# NEXUS_REQUIRE_MEMORY_SANDBOX="true"
